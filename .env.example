# ── AI (optional) ──────────────────────────────────────────────
# If unset, the Personal AI still works perfectly — it answers directly
# from the local knowledge base (src/data/*.json). Setting this key only
# makes the OpenAI model rephrase that same factual answer more naturally;
# it is explicitly forbidden from adding facts not already in the answer.
OPENAI_API_KEY=

# ── Admin panel ────────────────────────────────────────────────
# Password required to log into /admin.
ADMIN_PASSWORD=change-this-password

# Random long string used to sign admin session cookies.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
